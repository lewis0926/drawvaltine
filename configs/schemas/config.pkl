/// Configuration schema for Drawvaltine portfolio website
module Config

/// Frontend configuration
class Frontend {
  /// Port for the Vite dev server
  port: UInt16 = 5173

  /// API URL that frontend uses to connect to backend
  apiUrl: String
}

/// Backend configuration
class Backend {
  /// Host address for Strapi
  host: String = "0.0.0.0"

  /// Port for Strapi server
  port: UInt16 = 1337

  /// Path to SQLite database file
  databasePath: String = "./database/data.db"

  /// Directory for uploaded media files
  uploadsDir: String = "./public/uploads"
}

/// Application secrets (should be overridden per environment)
class Secrets {
  /// Strapi app keys (comma-separated)
  appKeys: String

  /// Admin JWT secret
  adminJwtSecret: String

  /// API token salt
  apiTokenSalt: String

  /// Transfer token salt
  transferTokenSalt: String

  /// JWT secret
  jwtSecret: String
}

/// Root configuration
frontend: Frontend
backend: Backend
secrets: Secrets
