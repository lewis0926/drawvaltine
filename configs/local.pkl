/// Local development configuration
amends "schemas/config.pkl"

frontend {
  port = 5173
  apiUrl = "http://localhost:1337"
}

backend {
  host = "0.0.0.0"
  port = 1337
  databasePath = "./database/data.db"
  uploadsDir = "./public/uploads"
}

secrets {
  appKeys = "key1,key2,key3,key4"
  adminJwtSecret = "admin-jwt-secret-dev"
  apiTokenSalt = "api-token-salt-dev"
  transferTokenSalt = "transfer-token-salt-dev"
  jwtSecret = "jwt-secret-dev"
}
