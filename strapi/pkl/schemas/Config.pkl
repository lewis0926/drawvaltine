module Config

class ServerConfig {
  host: String = "0.0.0.0"
  port: UInt16 = 1337
}

class SecretsConfig {
  appKeys: String
  apiTokenSalt: String
  adminJwtSecret: String
  transferTokenSalt: String
  encryptionKey: String
  jwtSecret: String
}

class DatabaseConfig {
  client: String = "sqlite"
  host: String = ""
  port: String = ""
  name: String = ""
  username: String = ""
  password: String = ""
  ssl: Boolean = false
  filename: String = ".tmp/data.db"
}

server: ServerConfig
secrets: SecretsConfig
database: DatabaseConfig

function toEnv(): String = """
  # Server
  HOST=\(server.host)
  PORT=\(server.port)

  # Secrets
  APP_KEYS=\(secrets.appKeys)
  API_TOKEN_SALT=\(secrets.apiTokenSalt)
  ADMIN_JWT_SECRET=\(secrets.adminJwtSecret)
  TRANSFER_TOKEN_SALT=\(secrets.transferTokenSalt)
  ENCRYPTION_KEY=\(secrets.encryptionKey)
  JWT_SECRET=\(secrets.jwtSecret)

  # Database
  DATABASE_CLIENT=\(database.client)
  DATABASE_HOST=\(database.host)
  DATABASE_PORT=\(database.port)
  DATABASE_NAME=\(database.name)
  DATABASE_USERNAME=\(database.username)
  DATABASE_PASSWORD=\(database.password)
  DATABASE_SSL=\(database.ssl)
  DATABASE_FILENAME=\(database.filename)
  """